{
  "name": "map-to-table-php",
  "private": true,
  "version": "1.0.0",
  "description": "PHP-rendered MAP TO TABLE exhibition and shared design system",
  "scripts": {
    "prepare": "node tools/prepare-assets.mjs",
    "build": "node tools/prepare-assets.mjs && node tools/lint-php.mjs && php tools/check.php",
    "lint": "node tools/lint-php.mjs",
    "test:mobile": "node tests/mobile.mjs",
    "test:media": "node tests/media-smoke.mjs",
