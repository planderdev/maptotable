    "start": "php -S 127.0.0.1:8080 -t public router.php"
  },
  "dependencies": {
    "aos": "2.3.4",
    "gsap": "3.14.2",
    "lucide-static": "0.468.0",
    "swiper": "14.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "lighthouse": "13.6.0",
    "playwright": "1.56.1",
    "sharp": "0.35.5"
  }
}
