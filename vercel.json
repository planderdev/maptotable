{
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0" }
  },
  "outputDirectory": "public",
  "routes": [
    { "src": "/(.*)", "headers": { "X-Robots-Tag": "noindex, nofollow, noimageindex" }, "continue": true },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/(.*)\\.php", "dest": "/api/index.php" },
    { "src": "/\\.htaccess", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
